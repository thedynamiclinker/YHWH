set -eu
checkout=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
cd "$checkout"
ledger=var/log/new-world-shell-runs
digest=$(prompt | git hash-object --stdin)
exec 9<var/log
flock 9
runs=$(awk -v digest="$digest" '$1 == digest { count++ } END { print count+0 }' "$ledger")
round=$((runs + 1))

choose() {
    printf '\n%s\n  1) %s\n  2) %s\n  3) %s\n  4) Other (type your answer)\n' "$@" >&2
    while printf '> ' >&2 && IFS= read -r answer <&3; do
        case $answer in
            1) printf '%s' "$2"; return ;;
            2) printf '%s' "$3"; return ;;
            3) printf '%s' "$4"; return ;;
            4) printf 'Your answer: ' >&2; IFS= read -r answer <&3 || return 1
               if [ -n "$answer" ]; then printf '%s' "$answer"; return; fi ;;
        esac
    done
    return 1
}

if [ "$runs" -gt 0 ]; then
    if ! { exec 3</dev/tty; } 2>/dev/null; then
        printf 'Run %s needs a terminal to answer the New World Shell questions.\n' "$round" >&2
        exit 1
    fi
    printf 'New World Shell · run %s\n' "$round" >&2
    priority=$(choose 'What needs the next pass after daily use?' 'Directory navigation and switching @' 'Initial and shell configuration' 'Universe creation and guest shells')
    surface=$(choose 'Where did that get in your way?' 'Desktop or Three' 'Shaddai TTY' 'Android or iOS')
fi

printf '%s\t%s\n' "$digest" "$(date -u +%FT%TZ)" >> "$ledger"
flock -u 9
exec 9<&-
{
    prompt
    if [ "$runs" -gt 0 ]; then
        printf '\nThis is run %s of the unchanged prompt. The user already answered the rerun questions.\n' "$round"
        printf 'Priority: %s\nInterface: %s\nUse these answers to choose the next iteration. Start from the current checkout.\n' "$priority" "$surface"
    fi
} | lordhavemercy -f --verbose
