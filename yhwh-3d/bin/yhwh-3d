#!/usr/bin/env bash
set -e
app_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
case "${1-}" in
    --help|-h) printf 'Usage: yhwh-3d [PATH]\n       yhwh-3d --root PATH\n       yhwh-3d --help\nOpen a filesystem path in YHWH 3D. Ctrl+P opens commands.\n'; exit 0 ;;
    --version) printf 'YHWH 3D 0.1.0\n'; exit 0 ;;
esac
if [[ "${1-}" != -* && -n "${1-}" ]]; then
    export YHWH_3D_OPEN="$(realpath -- "$1")"
    shift
fi
exec node "$app_dir/scripts/start.cjs" "$@"
