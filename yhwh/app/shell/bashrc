# Preserve the user's normal interactive shell, then add one prompt hook.
[[ "$YHWH_NO_SHELL_RC" != 1 && -f ~/.bashrc ]] && source ~/.bashrc
__yhwh_prompt() {
    local __yhwh_cwd="${PWD//%/%25}"
    __yhwh_cwd="${__yhwh_cwd// /%20}"
    __yhwh_cwd="${__yhwh_cwd//#/%23}"
    __yhwh_cwd="${__yhwh_cwd//\?/%3F}"
    __yhwh_cwd="${__yhwh_cwd//$'\n'/%0A}"
    __yhwh_cwd="${__yhwh_cwd//$'\r'/%0D}"
    __yhwh_cwd="${__yhwh_cwd//$'\a'/%07}"
    __yhwh_cwd="${__yhwh_cwd//$'\e'/%1B}"
    printf '\033]7;file://localhost%s\007\033]133;A\007' "$__yhwh_cwd"
}
if declare -p PROMPT_COMMAND 2>/dev/null | grep -q 'declare -a'; then
    PROMPT_COMMAND+=(__yhwh_prompt)
else
    PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND; }__yhwh_prompt"
fi
HISTCONTROL="${HISTCONTROL:+$HISTCONTROL:}ignorespace"
