{
  "name": "yhwh-desktop",
  "productName": "YHWH",
  "version": "0.2.0",
  "private": true,
  "description": "Files, a shell, and somewhere to think. No vault required.",
  "main": "app/main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "node scripts/cli.cjs",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node test/ui.cjs",
    "package": "electron-packager . YHWH --out=build/packages --overwrite --ignore=^/test --ignore=^/build/packages --ignore=^/node_modules/.cache"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.3.0",
    "marked": "^17.0.1",
    "node-pty": "^1.1.0",
    "prettier": "^3.6.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.3",
    "esbuild": "^0.25.12",
    "playwright": "^1.65.0"
  }
}
