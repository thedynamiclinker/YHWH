{
  "name": "yhwh-system",
  "version": "0.3.0",
  "private": true,
  "description": "YHWH interfaces and executable English workflow",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "yhwh": "bin/yhwh",
    "yhwh-default": "bin/yhwh-default",
    "yhwh-three": "bin/yhwh-three",
    "yhwh-obsidian": "bin/yhwh-obsidian"
  },
  "files": [
    "bin",
    "lib",
    "etc",
    "src",
    "Makefile",
    "README.md",
    "test",
    "var/tmp/yhwh/default/ui",
    "var/tmp/yhwh/three/renderer*",
    "var/tmp/yhwh/three/*.ttf",
    "var/tmp/yhwh/obsidian/main.js",
    "var/tmp/yhwh/obsidian/styles.css"
  ],
  "scripts": {
    "build": "node bin/build.cjs",
    "test": "node --test test/*.test.cjs",
    "check": "make check"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.0",
    "@codemirror/view": "^6.38.6",
    "@inquirer/prompts": "^8.8.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.3.0",
    "lucide": "^0.468.0",
    "marked": "^17.0.1",
    "node-pty": "^1.1.0",
    "prettier": "^3.6.2",
    "three": "^0.185.0",
    "electron": "^45.2.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.12",
    "obsidian": "^1.14.4",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2"
  },
  "bundleDependencies": [
    "@codemirror/lang-html",
    "@codemirror/lang-javascript",
    "@codemirror/lang-json",
    "@codemirror/lang-markdown",
    "@codemirror/language",
    "@codemirror/language-data",
    "@codemirror/state",
    "@codemirror/theme-one-dark",
    "@codemirror/view",
    "@inquirer/prompts",
    "@xterm/addon-fit",
    "@xterm/xterm",
    "codemirror",
    "dompurify",
    "lucide",
    "marked",
    "node-pty",
    "prettier",
    "three",
    "electron"
  ],
  "allowScripts": {
    "esbuild": true,
    "node-pty": true,
    "electron": true
  }
}
