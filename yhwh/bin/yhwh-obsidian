#!/usr/bin/env node
const args=process.argv.slice(2);
if(!args.length||args[0]==='open') {
  const { spawnSync }=require('node:child_process');
  const url='obsidian://open'+(args[1]?'?path='+encodeURIComponent(require('node:path').resolve(args[1])):'');
  const r=spawnSync(process.platform==='darwin'?'open':'xdg-open',[url],{stdio:'inherit'});
  if(r.error) {console.error(r.error.message);process.exitCode=1;} else process.exitCode=r.status??1;
} else if(args[0]==='--version') console.log(require('../package.json').version);
else import('./obsidian/cli.mjs').then(cli=>cli.main(args)).catch(error=>{console.error('yhwh-obsidian: '+error.message);process.exitCode=1;});
