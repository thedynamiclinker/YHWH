#!/usr/bin/env node
const args=process.argv.slice(2);
if(args.includes('--help')||args.includes('-h'))console.log('yhwh-three — Open the spatial filesystem interface\n\nUsage: yhwh-three [PATH] [--root PATH]');
else if(args.includes('--version')) console.log(require('../package.json').version);
else { if(args[0]&&!args[0].startsWith('-')) { process.env.YHWH_THREE_OPEN=require('node:path').resolve(args.shift()); } process.argv=[process.argv[0],process.argv[1],...args]; require('./three/start.cjs'); }
