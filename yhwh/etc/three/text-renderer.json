  "nietzsche-family-circus-another-universe-origina": "{{0}}<div class=\"eyebrow\">NIETZSCHE FAMILY CIRCUS</div><img class=\"circus\" src=\"{{1}}\" alt=\"Family Circus cartoon\"><blockquote>{{2}}</blockquote><div class=\"dialog-buttons\"><button data-action=\"circus\">Another universe</button><button data-url=\"{{3}}\">Original pairing ↗</button></div>",
  "coming-soon-mostly-more-from-the-mountain-you-ar": "{{0}}<div class=\"eyebrow\">COMING SOON / MOSTLY</div><h2>More from the mountain.</h2><p>{{1}}</p><p>You are already in YHWH Three. Sync, Stuff and Dating are not implemented. No pre-orders are taken.</p><button data-action=\"edit-voice\">Edit this advertisement</button>",
