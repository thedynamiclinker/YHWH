# YHWH prefixes contain ordinary shell configuration and files.
# Copy settings to ~/.config/yhwh/etc/profile, or an ancestor .yhwh/etc/profile.
# export yhwh_keys_directory=etc/keys
# export yhwh_bashrc_file=etc/bashrc
# export yhwh_completions_directory=lib/bash/completions

# @ is a tab's shell prefix. Relative paths follow @. Absolute paths are fixed.
# yhwh_bin=bin
# yhwh_lib=lib
# yhwh_etc=etc
# yhwh_at_path=yes
# yhwh_at_rc=.yhwh/etc/at
# yhwh_cd_rc=.yhwh/etc/cd
#
# Bash tabs use ~/.bshrc. When absent, opt in to ~/.bashrc with this setting.
# yhwh_home_rc=yes
# export YHWH_LORD_IS=https://github.com/thedynamiclinker/lord
#
# Commands and functions here run in the real shell.
# yhwh_enter() { printf '@ %s\n' "$1"; }
# yhwh_leave() { :; }  # $1 old @, $2 new @
# yhwh_cd() { printf '. %s\n' "$1"; }  # $1 new PWD, $2 previous PWD
# yhwh_cd_rc is sourced on cd, with those same arguments. Enable it for directories you trust.
#
# Source this profile again and refresh @ with: cwat --reload
# Shell-first Shaddai startup: yhwh_shell_first=true
