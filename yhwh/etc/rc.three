# Three uses the shared desktop. Put this in ~/.config/yhwh/rc.three.
# It follows rc at each scope; use the same hierarchical shell syntax.
/
    # spatial_effects=false
    # motion=0
    # spatial_strength=1.0
    # ui_font_size=16
    # terminal_font_size=15
    # stylesheet="$HOME/config/yhwh/my-theme.css"
    # plugins='["/path/to/plugin-directory"]'
