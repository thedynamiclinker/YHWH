# ENV for the Linux guest. The shell and its startup files live inside /.
export YHWH_GUEST=1
[ ! -r "$HOME/.shrc" ] || . "$HOME/.shrc"
[ ! -r /etc/yhwh/profile ] || . /etc/yhwh/profile
. /tmp/.yhwh-session

cd() {
    __yhwh_cd "$@" && __yhwh_cd_hook
}

# Some BusyBox builds omit command substitutions in PS1. Report changes above.
PS1="$(printf '\033]133;A\007')\$ "
