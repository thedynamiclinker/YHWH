# To source ~/.bashrc, set yhwh_home_rc=yes in the YHWH etc/profile.
if [[ "$YHWH_NO_SHELL_RC" != 1 && "${yhwh_home_rc:-no}" == yes && -r ~/.bashrc ]]; then . ~/.bashrc; fi
[[ -f "$YHWH_BUNDLED_COMPLETION" ]] && . "$YHWH_BUNDLED_COMPLETION"
if [[ -f "$YHWH_PREFIX_SHELL" ]]; then
    eval "$("${YHWH_NODE:-node}" "$YHWH_PREFIX_SHELL")"
fi

__yhwh_command_names() {
    local name
    while IFS= read -r name; do printf '%s\0' "$name"; done < <(compgen -A alias -A function -A builtin)
}
. "$YHWH_SHELL_LIB"

function cd {
    __yhwh_cd "$@" && __yhwh_cd_hook
}
function @-set { cwat "$@"; }

for __yhwh_map in emacs-standard vi-insertion vi-command; do
    bind -m "$__yhwh_map" -x '"\e[277~":__yhwh_at'
done
unset __yhwh_map
_yhwh_un() { COMPREPLY=($(compgen -W 'new cd go ls' -- "${COMP_WORDS[COMP_CWORD]}")); }
complete -F _yhwh_un un
if [[ $(declare -p PROMPT_COMMAND 2>/dev/null) == 'declare -a'* ]]; then
    PROMPT_COMMAND+=(__yhwh_prompt)
else
    PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND; }__yhwh_prompt"
fi
HISTCONTROL="${HISTCONTROL:+$HISTCONTROL:}ignorespace"
